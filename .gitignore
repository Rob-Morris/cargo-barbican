**/*.rs.bk
*.swp
*.swo

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# macOS
.DS_Store

# editor / IDE
.idea/
.vscode/
*.iml

# brain local state
.brain/local/

# local agent overrides
AGENTS.local.md
CLAUDE.local.md
agents.local.md
claude.local.md

# transient canary receipts
.canary--*
