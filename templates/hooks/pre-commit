#!/bin/sh
# Synced from cargo-barbican v0.35.0
#
# Advisory client-side pre-commit hook for cargo-barbican.
#
# It runs the cheap subset of the enforcement gate so obvious policy breaks are
# caught before they reach CI:
#   - cargo barbican pin check       reviewed-target enforcement
#   - cargo barbican inventory --enforce   the coverage floor
#
# It deliberately does NOT run `cargo barbican verify` (a full build and test),
# which is too slow to run on every commit.
#
# Advisory and skippable with git commit --no-verify. CI enforcement requires
# operator-configured required checks, branch protection and policy review.
# Run from the intended Cargo workspace root, with the selected toolchain and
# cargo-barbican on PATH and frozen metadata inputs cached. No scanner or hook
# framework is required. Preinstall the toolchain; rustup semantics still apply.
#
# policy init --pre-commit-hook copies this file without executable bits.
# Review before explicit activation. For existing hooks, nested workspaces,
# manual installation and all-hook hooksPath effects, see the matching release's
# docs/user/ci.md#pre-commit-hook. Init changes no Git configuration.
set -eu

cargo barbican pin check
cargo barbican inventory --enforce
